# Copy to .env (gitignored). Never commit real keys.

# Database (docker compose -f infra/docker-compose.yml up -d db)
DATABASE_URL=postgresql+asyncpg://riskminer:riskminer@localhost:5434/riskminer
POSTGRES_USER=riskminer
POSTGRES_PASSWORD=riskminer
POSTGRES_DB=riskminer
RISKMINER_DB_PORT=5434
RISKMINER_API_PORT=8000

# App config (feature flags, LLM routing, connectors)
RISKMINER_CONFIG=config/config.yaml

# Demo access (Caddy / API basic auth), "user:password"
RISKMINER_BASIC_AUTH=

# API login (signed session cookie rm_session). Users: "name:role:scrypt_hash;name2:role:hash", roles expert|admin.
# Make a hash: cd backend && echo -n 'password' | uv run python -m riskminer.api.auth hash-password
RISKMINER_USERS=
# Secret signing the session cookie (any long random string; unset = random per process, sessions end on restart)
RISKMINER_SESSION_SECRET=
# Set to true behind HTTPS (cookie Secure flag)
RISKMINER_COOKIE_SECURE=

# LLM providers (see config/config.example.yaml, llm.providers.*.api_key_env)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=
WCSS_VLLM_KEY=
# Hugging Face token for gated model weights (Bielik / PLLuM licences accepted on the account)
HF_TOKEN=
