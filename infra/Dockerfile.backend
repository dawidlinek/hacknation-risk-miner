FROM python:3.12-slim
# poppler-utils: pdftotext/pdfinfo for connectors (GPL tools run as separate binaries, not linked)
# libreoffice-writer-nogui: DOCX/DOC/ODT -> PDF for uploads and the analysis pack (MPL-2.0, separate binary)
# fonts: Polish glyphs in generated PDFs (DejaVu: free licence; Liberation: OFL)
# tesseract-ocr + tesseract-ocr-pol: OCR of scanned uploads (Apache-2.0, separate binary; job document_ocr, owner D)
RUN apt-get update && apt-get install -y --no-install-recommends \
      poppler-utils curl libreoffice-writer-nogui fonts-dejavu-core fonts-liberation \
      tesseract-ocr tesseract-ocr-pol \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# soffice needs a writable HOME; each call also uses its own -env:UserInstallation profile (documents/convert.py)
ENV HOME=/tmp
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
# sector pack (prod has no repo bind mount; settings().catalogue_dir = $RISKMINER_ROOT/catalogue)
COPY catalogue/ /app/catalogue/
RUN uv sync --frozen --no-dev
