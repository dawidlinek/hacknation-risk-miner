    },
    "h1": {
      "size": 36,
      "weight": 600,
      "tracking": "-0.035em",
      "lineHeight": 1.1,
      "use": "page title"
    },
    "stat": {
      "size": 28,
      "weight": 600,
      "tracking": "-0.04em",
      "lineHeight": 1.0,
      "use": "numbers on soft stat cards"
    },
    "h2": {
      "size": 20,
      "weight": 600,
      "tracking": "-0.02em",
      "lineHeight": 1.25,
      "use": "section heading"
    },
    "h3": {
      "size": 18,
      "weight": 600,
      "tracking": "-0.015em",
      "lineHeight": 1.3,
      "use": "panel heading"
    },
    "summary": {
      "size": 20,
      "weight": 500,
      "tracking": "-0.01em",
      "lineHeight": 1.45,
      "use": "plain-language line on the black summary card"
    },
    "item-title": {
      "size": 15,
      "weight": 600,
      "tracking": "0",
      "lineHeight": 1.35,
      "use": "list item / step title"
    },
    "body": {
      "size": 16,
      "weight": 400,
      "tracking": "0",
      "lineHeight": 1.55
    },
    "body-sm": {
      "size": 14,
      "weight": 400,
      "tracking": "0",
      "lineHeight": 1.45
    },
    "caption": {
      "size": 13,
      "weight": 400,
      "tracking": "0",
      "lineHeight": 1.4
    },
    "mono": {
      "size": 12,
      "weight": 500,
      "tracking": "0",
      "lineHeight": 1.4,
      "use": "IDs, notice numbers, provenance lines, n=, dates"
    },
    "eyebrow": {
      "size": 11,
      "weight": 600,
      "tracking": "0.08em",
      "lineHeight": 1.2,
      "transform": "uppercase",
      "use": "label on the black summary card only"
    }
