{
  "name": "ex-ante-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "lint": "biome check src e2e",
    "format": "biome format --write src e2e",
    "test": "vitest",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ${API_URL:-http://127.0.0.1:8000}/openapi.json -o src/api/schema.gen.ts",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
