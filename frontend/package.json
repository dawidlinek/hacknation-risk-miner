    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.128.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "31.0.1",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
