{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "e2e/**", "!src/routeTree.gen.ts", "!src/api/schema.gen.ts", "!src/components/ui/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "noSvgWithoutTitle": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
